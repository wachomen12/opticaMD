# ── Base de datos (Supabase / Neon) ─────────────────────────────
# Connection pooling (puerto 6543 en Supabase / -pooler en Neon)
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:6543/postgres?schema=public&pgbouncer=true"
# Conexión directa para migraciones (puerto 5432 en Supabase)
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?schema=public"

# ── Autenticación ───────────────────────────────────────────────
# Credenciales del administrador. Cámbialas antes de publicar en Vercel.
ADMIN_EMAIL="admin@opticamd.ec"
ADMIN_PASSWORD="OpticaMD2026!"
# Clave secreta para firmar la cookie de sesión (httpOnly).
# Genera una cadena aleatoria de al menos 32 caracteres, por ejemplo:
#   openssl rand -base64 48
AUTH_SECRET="cambia-esta-clave-por-una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres"

# ── Aplicación ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="ÓPTICA MD"
# En local usa http://localhost:3000; en Vercel usa tu dominio público.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Modo demo (opcional) ────────────────────────────────────────
# true  = datos en memoria, sin PostgreSQL (ideal para probar la UI).
# false = usa DATABASE_URL y persiste en PostgreSQL.
DEMO_MODE="false"
