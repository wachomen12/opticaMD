# ── Base de datos (Neon / Supabase) ─────────────────────────────
# Neon: usa la cadena "Pooled" para DATABASE_URL (host con -pooler)
# y la "Direct" para DIRECT_URL (sin -pooler). Neon exige SSL.
# Si tu contraseña tiene caracteres especiales (@, #, %, etc.), codifícala:
#   @ -> %40   # -> %23   % -> %25   / -> %2F   : -> %3A
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Supabase (alternativa): pooler en 6543 y conexión directa en 5432.
# DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# ── Usuario administrador inicial ───────────────────────────────
# Se usan una sola vez con `npm run db:admin` para crear el usuario
# en la tabla `usuarios` con contraseña hasheada (scrypt).
ADMIN_EMAIL="admin@opticamd.ec"
ADMIN_PASSWORD="cambia-esta-contraseña-antes-de-ejecutar-db:admin"
ADMIN_NAME="Administrador"

# ── Autenticación ───────────────────────────────────────────────
# Clave secreta para firmar la cookie de sesión (obligatoria, 32+ caracteres).
# Genera una cadena aleatoria, por ejemplo:
#   openssl rand -base64 48
AUTH_SECRET="cambia-esta-clave-por-una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres"

# ── Aplicación ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="ÓPTICA MD"
# En local usa http://localhost:3000; en Vercel usa tu dominio público.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
